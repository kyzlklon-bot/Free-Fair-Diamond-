/* WHEEL */
var PRIZES=[1,5,10,15,20,5,10,15];
var COLORS=['#e74c3c','#3498db','#2ecc71','#f39c12','#9b59b6','#e67e22','#1abc9c','#c0392b'];
var spinning=false,currentAngle=0;
function drawWheel(){
  var c=document.getElementById('spinCanvas');if(!c)return;
  var ctx=c.getContext('2d'),cx=140,cy=140,r=128,seg=PRIZES.length;
  ctx.clearRect(0,0,280,280);
  for(var i=0;i<seg;i++){
    var s=currentAngle+i*(2*Math.PI/seg),e=s+(2*Math.PI/seg);
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,r,s,e);ctx.closePath();
    ctx.fillStyle=COLORS[i];ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,0.25)';ctx.lineWidth=2;ctx.stroke();
    ctx.save();ctx.translate(cx,cy);ctx.rotate(s+(e-s)/2);
    ctx.fillStyle='#fff';ctx.font='bold 14px Segoe UI';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(PRIZES[i],r*0.65,0);ctx.restore();
  }
  ctx.beginPath();ctx.arc(cx,cy,22,0,2*Math.PI);
  ctx.fillStyle='#1a2340';ctx.fill();ctx.strokeStyle='rgba(0,207,255,0.7)';ctx.lineWidth=3;ctx.stroke();
  ctx.fillStyle='#00cfff';ctx.font='bold 10px Segoe UI';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('FF',cx,cy);
}
function doSpin(){
  if(spinning)return;
  if(state.spins<=0){flash('No spins! Watch an ad first.');return;}
  spinning=true;state.spins--;
  document.getElementById('spinBtn').disabled=true;
  var mult=state.vip==='GOLD'?5:state.vip==='SILVER'?3:state.vip==='BRONZE'?2:1;
  var tot=8*2*Math.PI+Math.random()*2*Math.PI,start=null,dur=4200,init=currentAngle;
  function anim(ts){
    if(!start)start=ts;
    var el=ts-start,prog=Math.min(el/dur,1),ease=1-Math.pow(1-prog,4);
    currentAngle=init+tot*ease;drawWheel();
    if(prog<1){requestAnimationFrame(anim);}
    else{
      var norm=((currentAngle%(2*Math.PI))+2*Math.PI)%(2*Math.PI);
      var sa=2*Math.PI/PRIZES.length;
      var idx=Math.floor(((2*Math.PI-norm+sa/2)%(2*Math.PI))/sa)%PRIZES.length;
      var prize=PRIZES[idx]*mult;
      state.balance+=prize;state.totalEarned+=prize;
      state.tasks.spin3=Math.min(3,(state.tasks.spin3||0)+1);
      if(state.tasks.spin3>=3)checkTaskReward('spin3',30);
      addHistory('🎰 Spin won','+ '+prize+' Coin');
      setText('winAmount','+'+prize+' Coin'+(mult>1?' (x'+mult+')':''));
      checkAchievements();
      var toast=document.getElementById('winToast');
      toast.classList.add('show');
      setTimeout(function(){toast.classList.remove('show');spinning=false;document.getElementById('spinBtn').disabled=false;updateAll();},2200);
    }
  }
  requestAnimationFrame(anim);
}

/* SCRATCH CARD */
var scratchPrizes=[5,10,20,50,0,0,0,15];
var scratchPrize=0,scratchDone=false,scratchEnabled=true;
function initScratch(){
  var c=document.getElementById('scratchCanvas');if(!c)return;
  scratchPrize=scratchPrizes[Math.floor(Math.random()*scratchPrizes.length)];
  scratchDone=false;
  var ctx=c.getContext('2d');
  ctx.fillStyle=scratchPrize>0?'#1a3a1a':'#3a1a1a';
  ctx.fillRect(0,0,260,100);
  ctx.fillStyle=scratchPrize>0?'#00ff88':'#ff4444';
  ctx.font='bold 28px Segoe UI';ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText(scratchPrize>0?'+'+scratchPrize+' Coin':'Try Again',130,50);
  ctx.fillStyle='#888';
  ctx.fillRect(0,0,260,100);
  ctx.fillStyle='#aaa';ctx.font='bold 18px Segoe UI';ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText('✦ Scratch Here ✦',130,50);
  document.getElementById('scratchResult').textContent='';
  document.getElementById('scratchHint').textContent='Scratch the card above!';
  c.onmousedown=function(){scratchEnabled&&startScratch(c);};
  c.ontouchstart=function(e){e.preventDefault();scratchEnabled&&startScratch(c,e);};
}
function startScratch(c,te){
  var ctx=c.getContext('2d');
  ctx.globalCompositeOperation='destination-out';
  function move(x,y){
    var r=c.getBoundingClientRect();
    var px=(x-r.left)*(260/r.width),py=(y-r.top)*(100/r.height);
    ctx.beginPath();ctx.arc(px,py,18,0,2*Math.PI);ctx.fill();
    var data=ctx.getImageData(0,0,260,100).data;
    var transparent=0;
    for(var i=3;i<data.length;i+=4)if(data[i]<128)transparent++;
    if(transparent/data.length*4>0.6&&!scratchDone)revealScratch();
  }
  c.onmousemove=function(e){move(e.clientX,e.clientY);};
  c.ontouchmove=function(e){e.preventDefault();move(e.touches[0].clientX,e.touches[0].clientY);};
  c.onmouseup=c.onmouseleave=function(){c.onmousemove=null;};
  c.ontouchend=function(){c.ontouchmove=null;};
}
function revealScratch(){
  scratchDone=true;
  var c=document.getElementById('scratchCanvas');
  var ctx=c.getContext('2d');
  ctx.globalCompositeOperation='destination-out';
  ctx.fillRect(0,0,260,100);
  if(scratchPrize>0){
    state.balance+=scratchPrize;state.totalEarned+=scratchPrize;
    addHistory('🎟 Scratch card','+ '+scratchPrize+' Coin');
    document.getElementById('scratchResult').textContent='🎉 Won '+scratchPrize+' Coin!';
    updateAll();flash('+'+scratchPrize+' Coin from scratch! 🎟');
  }else{
    document.getElementById('scratchResult').textContent='😔 Better luck next time!';
  }
  document.getElementById('scratchHint').textContent='Watch an ad for a new card';
  scratchEnabled=false;
}
function newScratch(){
  maybeOpenAd();
  state.adsWatched++;state.totalEarned+=10;state.balance+=10;
  addHistory('📺 Ad for scratch','+ 10 Coin');
  scratchEnabled=true;initScratch();updateAll();flash('New scratch card! 🎟');
}

