<script>
var STORAGE_KEY='ff_diamond_v3';
var ADSTERRA='https://www.effectivecpmnetwork.com/hsefgs7ghq?key=3599484f35ede989aec9a3a494d6a72c';
var ADS_ENABLED=false; 
function maybeOpenAd(){if(ADS_ENABLED)window.open(ADSTERRA,'_blank');}

function genCode(){var c='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789',r='';for(var i=0;i<8;i++)r+=c[Math.floor(Math.random()*c.length)];return r.slice(0,4)+'-'+r.slice(4);}
function loadState(){try{var r=localStorage.getItem(STORAGE_KEY);if(r)return JSON.parse(r);}catch(e){}return null;}
function saveState(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify(state));}catch(e){}}

var saved=loadState();
var today=new Date().toDateString();
var state=saved||{
  balance:0,adsWatched:0,totalEarned:0,spins:0,diamonds:0,
  gameId:'',purchases:[],history:[],timer:86400,emoteTimer:86400,
  transferEndSec:0,bellReady:false,loggedIn:false,userCode:genCode(),
  vip:'FREE',vipExpiry:null,checkin:[],lastCheckin:'',bonusDate:'',
  tasks:{watch5:0,spin3:0,buy1:false},tasksDate:'',
  achievements:[],theme:'dark'
};
if(!state.userCode)state.userCode=genCode();
if(state.tasksDate!==today){state.tasks={watch5:0,spin3:0,buy1:false};state.tasksDate=today;}
if(state.vipExpiry===undefined) state.vipExpiry=null;

/* STARS */
function makeStars(){
  var bg=document.getElementById('starsBg');
  for(var i=0;i<50;i++){
    var s=document.createElement('div');
    s.className='star';
    var size=Math.random()*2+1;
    s.style.cssText='width:'+size+'px;height:'+size+'px;top:'+Math.random()*100+'%;left:'+Math.random()*100+'%;animation-delay:'+Math.random()*3+'s;animation-duration:'+(2+Math.random()*3)+'s;';
    bg.appendChild(s);
  }
}

/* SPLASH */
function showSplash(cb){
  var bar=document.getElementById('splashBar'),pct=document.getElementById('splashPct'),p=0;
  var iv=setInterval(function(){
    p+=Math.random()*8+2;if(p>100)p=100;
    bar.style.width=Math.round(p)+'%';
    pct.textContent=Math.round(p)+'%';
    if(p>=100){clearInterval(iv);setTimeout(function(){document.getElementById('splash').classList.add('hidden');cb();},400);}
  },80);
}

/* NAV */
var NAV=[{icon:'📢',label:'Ads'},{icon:'🎰',label:'Spin'},{icon:'📊',label:'Stats'},{icon:'🛒',label:'Shop'},{icon:'👤',label:'Profile'}];
function buildNavs(){
  for(var n=1;n<=5;n++){
    var el=document.getElementById('nav'+n);
    el.innerHTML=NAV.map(function(item,i){
      return '<button class="nav-btn'+(i===(n-1)?' active':'')+'\" onclick="gotoPage('+(i+1)+')"><span>'+item.icon+'</span>'+item.label+'</button>';
    }).join('');
  }
}
function gotoPage(n){
  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});
  document.getElementById('p'+n).classList.add('active');
  updateAll();
}

/* GOOGLE LOGIN */
function doGoogleLogin(){
  var btn=document.getElementById('googleBtn');
  btn.style.opacity='0.6';btn.style.pointerEvents='none';
  btn.querySelector('.google-btn-text').textContent='Signing in...';
  setTimeout(function(){
    state.loggedIn=true;saveState();
    document.getElementById('loginPage').classList.add('hidden');
    document.getElementById('mainApp').style.display='block';
    initApp();
  },1800);
}

function initApp(){
  buildNavs();makeStars();drawWheel();initScratch();
  buildCheckin();buildTasks();buildLeaderboard();buildAchievements();
  if(state.theme==='light')document.body.classList.add('light');
  updateAll();startTimer();
}

/* UPDATE ALL */
function updateAll(){
  var b=Math.floor(state.balance);
  for(var n=1;n<=5;n++){var e=document.getElementById('d'+n+'bal');if(e)e.textContent=b;}
  setText('adsWatched',state.adsWatched);setText('totalEarned',state.totalEarned);
  setText('spinCount',state.spins);
  setText('s_ads',state.adsWatched);setText('s_earned',state.totalEarned);
  setText('s_spins',state.spins);setText('s_diamonds',state.diamonds);
  setText('pAds',state.adsWatched);setText('pDollars',state.totalEarned);setText('pDiamonds',state.diamonds);
  setText('pId',state.gameId||'—');setText('pCode',state.userCode);
  if(state.gameId)setText('pName','Player #'+state.gameId.slice(0,6));
  
  // VIP ТЕКСЕРУ (30 КҮН ӨТКЕНІН НЕ ӨТПЕГЕНІН БІЛУ)
  var now = Date.now();
  if (state.vip !== 'FREE' && state.vipExpiry && state.vipExpiry < now) {
      state.vip = 'FREE';
      state.vipExpiry = null;
  }
  
  var vl = state.vip === 'FREE' ? 'FREE' : state.vip + ' VIP';
  setText('vipLabel', vl);
  setText('vipLabelProfile', vl);
  
  var tc=document.getElementById('transferCard');
  if(tc)tc.style.display=(state.transferEndSec>0)?'block':'none';
  var dot=document.getElementById('bellDot');
  if(dot)dot.classList.toggle('show',!!state.bellReady);
  var bb=document.getElementById('bonusBtn');
  if(state.bonusDate===today){bb.textContent='✅ Claimed';bb.disabled=true;}
  else{bb.textContent='Claim +50';bb.disabled=false;}
  updateHistory();updateSpentHistory();buildTasks();buildCheckin();buildAchievements();saveState();
}
function setText(id,val){var e=document.getElementById(id);if(e)e.textContent=val;}

/* DAILY BONUS */
function claimBonus(){
  if(state.bonusDate===today){flash('Already claimed today!');return;}
  state.bonusDate=today;state.balance+=50;state.totalEarned+=50;
  addHistory('🎁 Daily bonus','+ 50 Coin');
  checkAchievements();updateAll();flash('+50 Coin Daily Bonus! 🎁');
}

/* CHECK-IN */
function buildCheckin(){
  var grid=document.getElementById('checkinGrid');if(!grid)return;
  var rewards=[10,20,30,50,75,100,200];
  var days=state.checkin||[];
  grid.innerHTML=rewards.map(function(r,i){
    var done=days.indexOf(i)>-1;
    var isTodayDay=!done&&days.length===i;
    return '<div class="checkin-day'+(done?' done':'')+(isTodayDay?' today':'')+'">'+
      '<div class="day-num">Day '+(i+1)+'</div>'+
      (done?'<div class="check">✅</div>':'<div class="day-reward">'+r+'</div>')+
      '</div>';
  }).join('');
  if(state.lastCheckin!==today&&state.checkin.length<7){
    var nextDay=state.checkin.length;
    state.checkin.push(nextDay);
    state.lastCheckin=today;
    var rew=[10,20,30,50,75,100,200][nextDay]||10;
    state.balance+=rew;state.totalEarned+=rew;
    addHistory('📅 Day '+(nextDay+1)+' check-in','+ '+rew+' Coin');
    saveState();
  }
}

/* TASKS */
var TASK_DEFS=[
  {id:'watch5',label:'Watch 5 Ads',desc:'Watch 5 ads today',reward:50,max:5,key:'adsWatched'},
  {id:'spin3',label:'Spin 3 times',desc:'Use the wheel 3 times',reward:30,max:3,key:'spins3'},
  {id:'buy1',label:'Buy a Package',desc:'Purchase any diamond pack',reward:100,max:1,key:'buy1'}
];
function buildTasks(){
  var el=document.getElementById('taskList');if(!el)return;
  el.innerHTML=TASK_DEFS.map(function(t){
    var prog=t.id==='buy1'?(state.tasks.buy1?1:0):(state.tasks[t.id]||0);
    var done=prog>=t.max;
    var pct=Math.min(100,Math.round(prog/t.max*100));
    return '<div class="task-item">'+
      '<div class="task-icon">'+(done?'✅':'🎯')+'</div>'+
      '<div class="task-info">'+
        '<h4>'+t.label+'</h4><p>'+t.desc+'</p>'+
        '<div class="task-prog"><div class="task-prog-fill" style="width:'+pct+'%"></div></div>'+
        '<p style="font-size:10px;color:var(--ff-muted);margin-top:3px;">'+prog+'/'+t.max+'</p>'+
      '</div>'+
      '<span class="task-reward">+'+t.reward+'</span>'+
      (done?'<span class="task-done">✅</span>':'<button class="task-btn" disabled>In Progress</button>')+
    '</div>';
  }).join('');
}

