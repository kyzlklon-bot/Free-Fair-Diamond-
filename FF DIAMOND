var LB_NAMES=['FireKing99','DiamondPro','FFMaster','StarPlayer','NightHunter','IronWolf','BlazeFire','ColdSniper'];
function buildLeaderboard(){
  var el=document.getElementById('leaderboard');if(!el)return;
