  {id:'coin_100',icon:'💰',title:'Coin Collector',desc:'Earn 100 Coin total',check:function(){return state.totalEarned>=100;}},
  {id:'coin_500',icon:'🏆',title:'Rich Player',desc:'Earn 500 Coin total',check:function(){return state.totalEarned>=500;}},
  {id:'diamond_buyer',icon:'💎',title:'Diamond Buyer',desc:'Buy your first diamonds',check:function(){return state.diamonds>0;}},
  {id:'vip_member',icon:'👑',title:'VIP Member',desc:'Activate any VIP',check:function(){return state.vip!=='FREE';}},
  {id:'scratch_win',icon:'🎟',title:'Lucky Scratch',desc:'Win from a scratch card',check:function(){return state.history.some(function(h){return h.label.includes('Scratch');});}},
];
function checkAchievements(){
  if(!state.achievements)state.achievements=[];
  ACHIEVEMENT_DEFS.forEach(function(a){
    if(state.achievements.indexOf(a.id)<0&&a.check()){
      state.achievements.push(a.id);
      addHistory('🏅 Achievement: '+a.title,'Unlocked!');
      flash('🏅 Achievement: '+a.title+'!');
    }
  });
}
function buildAchievements(){
  var el=document.getElementById('achievementList');if(!el)return;
  if(!state.achievements)state.achievements=[];
  el.innerHTML=ACHIEVEMENT_DEFS.map(function(a){
    var unlocked=state.achievements.indexOf(a.id)>-1;
    return '<div class="task-item" style="opacity:'+(unlocked?'1':'0.4')+'">'+
      '<div class="task-icon">'+a.icon+'</div>'+
      '<div class="task-info"><h4>'+a.title+'</h4><p>'+a.desc+'</p></div>'+
      (unlocked?'<span style="font-size:18px;">✅</span>':'<span style="font-size:11px;color:var(--ff-muted);">Locked</span>')+
    '</div>';
