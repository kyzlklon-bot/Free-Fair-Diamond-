/* TIMER */
function fmt(s){var h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=s%60;return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0');}
function startTimer(){
  setInterval(function(){
    if(state.timer>0)state.timer--;else state.timer=86400;
    if(state.transferEndSec>0){
      state.transferEndSec--;
      if(state.transferEndSec<=0){
        state.transferEndSec=0;state.bellReady=true;
        var dot=document.getElementById('bellDot');if(dot)dot.classList.add('show');
        var tc=document.getElementById('transferCard');if(tc)tc.style.display='none';
      }
    }
    var t=fmt(state.timer);
    setText('mainTimer',t);
    var tt=document.getElementById('transferTimer');if(tt)tt.textContent=fmt(state.transferEndSec);
    saveState();
  },1000);
}

/* NOTIFICATION BELL */
function openBellNotice(){
  if(state.bellReady){
    state.bellReady=false;
    var dot=document.getElementById('bellDot');if(dot)dot.classList.remove('show');
    saveState();
    showModal('💎 Diamonds Delivered!','Your diamond transfer has completed successfully.','OK');
