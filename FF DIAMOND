<!DOCTYPE html>
<html lang="kk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>FF Diamond</title>

<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:'Segoe UI',sans-serif;}
body{background:#000;display:flex;justify-content:center;align-items:flex-start;min-height:100vh;}
:root{
  --ff-bg:#0a0e1a;--ff-card:#12192b;--ff-card2:#1a2340;
  --ff-orange:#ff6b00;--ff-orange2:#ff9900;--ff-blue:#00cfff;
  --ff-green:#00ff88;--ff-gold:#ffd700;--ff-text:#e8eaf0;
  --ff-muted:#7a8599;--ff-pink:#ff3d8c;--ff-purple:#9b59ff;
}

/* SPLASH */
#splash{position:fixed;inset:0;z-index:200;background:linear-gradient(160deg,#0a0e1a,#0d1a33,#1a0d2a);display:flex;flex-direction:column;align-items:center;justify-content:center;}
#splash.hidden{display:none;}
.splash-logo{font-size:80px;animation:pulse 1s ease-in-out infinite alternate;}
.splash-title{font-size:32px;font-weight:900;color:var(--ff-blue);letter-spacing:3px;margin:12px 0 4px;}
.splash-sub{font-size:13px;color:var(--ff-muted);margin-bottom:40px;}
.splash-bar-bg{width:200px;height:6px;background:rgba(255,255,255,0.1);border-radius:10px;overflow:hidden;}
.splash-bar{height:100%;background:linear-gradient(90deg,var(--ff-blue),var(--ff-purple));border-radius:10px;width:0%;transition:width 0.1s;}
.splash-pct{font-size:12px;color:var(--ff-blue);margin-top:10px;font-family:monospace;}
@keyframes pulse{from{transform:scale(1);}to{transform:scale(1.08);}}

#app{width:390px;min-height:100vh;background:var(--ff-bg);color:var(--ff-text);overflow:hidden;position:relative;}

/* STARS BG */
.stars-bg{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;}
.star{position:absolute;border-radius:50%;background:#fff;animation:twinkle 3s ease-in-out infinite;}
@keyframes twinkle{0%,100%{opacity:0.1;}50%{opacity:0.6;}}

/* LOGIN */
#loginPage{position:fixed;inset:0;z-index:100;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(160deg,#0a0e1a 0%,#0d1a33 60%,#1a0d2a 100%);padding:32px 24px;}
#loginPage.hidden{display:none;}
.login-title{font-size:30px;font-weight:800;color:var(--ff-blue);letter-spacing:2px;margin-bottom:4px;text-align:center;}
.login-sub{font-size:13px;color:var(--ff-muted);margin-bottom:36px;text-align:center;}
.login-diamonds{display:flex;gap:8px;margin-bottom:24px;justify-content:center;}
.login-diamonds span{font-size:30px;animation:float 2s ease-in-out infinite;}
.login-diamonds span:nth-child(2){animation-delay:0.3s;}
.login-diamonds span:nth-child(3){animation-delay:0.6s;}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
.google-btn{width:100%;max-width:320px;background:#fff;border:none;border-radius:14px;padding:16px 22px;display:flex;align-items:center;gap:16px;cursor:pointer;transition:transform 0.15s;box-shadow:0 4px 24px rgba(0,0,0,0.4);}
.google-btn:active{transform:scale(0.97);}
.google-icon{width:24px;height:24px;flex-shrink:0;}
.google-btn-text{font-size:16px;font-weight:700;color:#1a1a1a;}
.google-btn-sub{font-size:11px;color:#666;margin-top:2px;}
.login-note{font-size:10px;color:var(--ff-muted);margin-top:20px;text-align:center;line-height:1.7;}

/* PAGES */
.page{display:none;flex-direction:column;min-height:100vh;position:relative;z-index:1;}
.page.active{display:flex;}
.topbar{background:linear-gradient(135deg,#1a2a4a,#0d1a33);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(0,207,255,0.15);}
.topbar-title{font-size:16px;font-weight:700;color:var(--ff-blue);}
.topbar-right{display:flex;align-items:center;gap:8px;}
.diamond-badge{background:linear-gradient(135deg,#1e3a6e,#0d2548);border:1px solid var(--ff-blue);border-radius:20px;padding:5px 12px;display:flex;align-items:center;gap:5px;font-size:13px;font-weight:700;color:var(--ff-gold);}
.vip-badge{background:linear-gradient(135deg,#b8860b,#ffd700);border-radius:12px;padding:3px 8px;font-size:10px;font-weight:800;color:#1a0a00;}
.nav{display:flex;background:#0d1424;border-top:1px solid rgba(0,207,255,0.1);position:sticky;bottom:0;z-index:10;}
.nav-btn{flex:1;padding:10px 2px;text-align:center;font-size:9px;color:var(--ff-muted);cursor:pointer;border:none;background:none;transition:all 0.2s;}
.nav-btn.active{color:var(--ff-orange);border-top:2px solid var(--ff-orange);}
.nav-btn span{display:block;font-size:18px;margin-bottom:2px;}
.content{flex:1;overflow-y:auto;padding:14px;}

/* DAILY BONUS */
.bonus-banner{background:linear-gradient(135deg,#2a1a00,#1a2a00);border:1px solid var(--ff-gold);border-radius:14px;padding:14px 16px;margin-bottom:14px;display:flex;align-items:center;gap:12px;cursor:pointer;transition:transform 0.15s;}
.bonus-banner:active{transform:scale(0.98);}
.bonus-icon{font-size:30px;}
.bonus-info h3{font-size:14px;font-weight:700;color:var(--ff-gold);}
.bonus-info p{font-size:11px;color:var(--ff-muted);margin-top:2px;}
.bonus-claim{margin-left:auto;background:linear-gradient(135deg,var(--ff-gold),#ff9900);border:none;border-radius:10px;padding:8px 14px;font-size:12px;font-weight:700;color:#1a0a00;cursor:pointer;white-space:nowrap;}
.bonus-claimed{margin-left:auto;font-size:11px;color:var(--ff-muted);}

/* AD PAGE */
.ad-hero{background:linear-gradient(135deg,#1a3a6e,#0d2040);border:1px solid rgba(0,207,255,0.2);border-radius:16px;padding:20px;text-align:center;margin-bottom:14px;}
.ad-hero h2{font-size:18px;font-weight:700;color:var(--ff-blue);margin-bottom:6px;}
.ad-reward{font-size:28px;font-weight:800;color:var(--ff-gold);margin:8px 0;}
.ad-box{background:var(--ff-card);border:1px solid rgba(255,107,0,0.3);border-radius:12px;padding:14px;margin-bottom:10px;display:flex;align-items:center;gap:12px;}
.ad-box-icon{width:50px;height:50px;background:linear-gradient(135deg,#ff6b00,#ff9900);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;}
.ad-box-info h3{font-size:13px;font-weight:600;margin-bottom:2px;}
.ad-box-info p{font-size:11px;color:var(--ff-muted);}
.ad-reward-tag{margin-left:auto;background:rgba(255,215,0,0.15);border:1px solid var(--ff-gold);border-radius:8px;padding:4px 10px;font-size:13px;font-weight:700;color:var(--ff-gold);white-space:nowrap;}
.watch-btn{width:100%;background:linear-gradient(135deg,var(--ff-orange),var(--ff-orange2));border:none;border-radius:12px;padding:15px;font-size:15px;font-weight:700;color:#fff;cursor:pointer;transition:transform 0.1s;}
.watch-btn:active{transform:scale(0.97);}
.watch-btn:disabled{opacity:0.5;cursor:not-allowed;}

/* TASKS */
.section-title{font-size:13px;font-weight:700;color:var(--ff-muted);text-transform:uppercase;letter-spacing:1px;margin:16px 0 8px;}
.task-item{background:var(--ff-card);border:1px solid rgba(0,207,255,0.1);border-radius:12px;padding:13px 14px;margin-bottom:8px;display:flex;align-items:center;gap:12px;}
.task-icon{font-size:22px;width:36px;text-align:center;flex-shrink:0;}
.task-info{flex:1;}
.task-info h4{font-size:13px;font-weight:600;}
.task-info p{font-size:11px;color:var(--ff-muted);margin-top:2px;}
.task-prog{height:4px;background:rgba(255,255,255,0.08);border-radius:4px;margin-top:6px;overflow:hidden;}
.task-prog-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--ff-blue),var(--ff-green));transition:width 0.4s;}
.task-reward{font-size:13px;font-weight:700;color:var(--ff-gold);white-space:nowrap;margin-right:8px;}
.task-btn{background:linear-gradient(135deg,var(--ff-green),#00cc66);border:none;border-radius:8px;padding:7px 12px;font-size:11px;font-weight:700;color:#001a0a;cursor:pointer;white-space:nowrap;}
.task-btn:disabled{opacity:0.4;cursor:not-allowed;background:#333;}
.task-done{font-size:18px;}

/* CHECKIN */
.checkin-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:14px;}
.checkin-day{background:var(--ff-card);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:8px 4px;text-align:center;font-size:10px;}
.checkin-day .day-num{font-size:9px;color:var(--ff-muted);margin-bottom:4px;}
.checkin-day .day-reward{font-size:11px;font-weight:700;color:var(--ff-gold);}
.checkin-day.done{border-color:var(--ff-green);background:rgba(0,255,136,0.08);}
.checkin-day.today{border-color:var(--ff-orange);background:rgba(255,107,0,0.12);}
.checkin-day .check{font-size:14px;}

/* SPIN */
.spin-header{text-align:center;padding:12px 0 6px;}
.spin-header h2{font-size:18px;font-weight:700;color:var(--ff-blue);}
.spin-remaining{font-size:12px;color:var(--ff-orange);margin-top:3px;}
.wheel-wrap{display:flex;align-items:center;justify-content:center;padding:8px 0 12px;position:relative;}
#spinCanvas{border-radius:50%;border:4px solid rgba(0,207,255,0.4);box-shadow:0 0 30px rgba(0,207,255,0.2);}
.wheel-pointer{position:absolute;top:4px;left:50%;transform:translateX(-50%);z-index:10;font-size:28px;filter:drop-shadow(0 2px 6px rgba(0,0,0,0.7));}
.win-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;pointer-events:none;}
.win-toast{transform:scale(0);background:linear-gradient(135deg,#1a3a1a,#0d2a0d);border:2px solid var(--ff-green);border-radius:18px;padding:20px 36px;text-align:center;transition:transform 0.3s;}
.win-toast.show{transform:scale(1);}
.win-toast h3{font-size:24px;font-weight:800;color:var(--ff-green);}
.win-toast p{font-size:13px;color:var(--ff-muted);margin-top:3px;}
.spin-btn{width:100%;background:linear-gradient(135deg,var(--ff-orange),var(--ff-orange2));border:none;border-radius:14px;padding:15px;font-size:16px;font-weight:800;color:#fff;cursor:pointer;letter-spacing:1px;transition:transform 0.1s;}
.spin-btn:active{transform:scale(0.97);}
.spin-btn:disabled{opacity:0.5;cursor:not-allowed;}
.spin-watch-btn{background:transparent;border:1px solid rgba(0,207,255,0.4);border-radius:12px;padding:12px;font-size:13px;font-weight:600;color:var(--ff-blue);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;width:100%;margin-top:8px;}

/* SCRATCH */
.scratch-wrap{background:var(--ff-card);border:1px solid rgba(255,215,0,0.2);border-radius:14px;padding:16px;margin-bottom:14px;text-align:center;}
.scratch-wrap h3{font-size:14px;font-weight:700;color:var(--ff-gold);margin-bottom:12px;}
.scratch-canvas{border-radius:12px;cursor:pointer;display:block;margin:0 auto;touch-action:none;}
.scratch-result{font-size:24px;font-weight:800;color:var(--ff-green);margin-top:10px;min-height:36px;}
.scratch-hint{font-size:11px;color:var(--ff-muted);margin-top:4px;}

/* STATS */
.stat-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;}
.stat-card{background:var(--ff-card);border:1px solid rgba(0,207,255,0.12);border-radius:12px;padding:14px;text-align:center;}
.stat-card .val{font-size:22px;font-weight:800;color:var(--ff-gold);}
.stat-card .lbl{font-size:10px;color:var(--ff-muted);margin-top:2px;text-transform:uppercase;letter-spacing:0.5px;}
.timer-card{background:linear-gradient(135deg,#1a1a3a,#0d0d2a);border:1px solid rgba(155,89,255,0.3);border-radius:14px;padding:16px;text-align:center;margin-bottom:14px;}
.timer-card h3{font-size:12px;color:var(--ff-muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px;}
.timer-display{font-size:34px;font-weight:800;color:var(--ff-purple);letter-spacing:3px;font-family:monospace;}
.history-item{background:var(--ff-card);border-radius:10px;padding:10px 14px;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;font-size:12px;}
.history-item .time{color:var(--ff-muted);}
.history-item .reward{color:var(--ff-gold);font-weight:700;}

/* LEADERBOARD */
.lb-item{background:var(--ff-card);border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:12px;}
.lb-rank{font-size:18px;width:28px;text-align:center;font-weight:800;}
.lb-rank.gold{color:var(--ff-gold);}
.lb-rank.silver{color:#c0c0c0;}
.lb-rank.bronze{color:#cd7f32;}
.lb-info{flex:1;}
.lb-info h4{font-size:13px;font-weight:600;}
.lb-info p{font-size:11px;color:var(--ff-muted);}
.lb-score{font-size:14px;font-weight:700;color:var(--ff-gold);}
.lb-me{border:1px solid var(--ff-orange);}

/* SHOP */
.tab-row{display:flex;background:var(--ff-card);border-radius:12px;padding:4px;margin-bottom:14px;gap:3px;}
.tab-btn{flex:1;padding:8px 4px;border:none;background:none;color:var(--ff-muted);font-size:11px;font-weight:600;border-radius:8px;cursor:pointer;transition:all 0.2s;}
.tab-btn.active{background:linear-gradient(135deg,var(--ff-orange),var(--ff-orange2));color:#fff;}
.shop-tab{display:none;}
.shop-tab.active{display:block;}
.diamond-pkg{background:var(--ff-card);border:1px solid rgba(255,215,0,0.2);border-radius:14px;padding:13px 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px;}
.diamond-pkg.featured{border-color:var(--ff-gold);background:linear-gradient(135deg,#1a1400,#1a0d00);}
.pkg-icon{font-size:28px;width:44px;text-align:center;}
.pkg-info{flex:1;}
.pkg-info h3{font-size:13px;font-weight:700;}
.pkg-info p{font-size:11px;color:var(--ff-muted);margin-top:2px;}
.pkg-price{font-size:14px;font-weight:800;color:var(--ff-gold);margin-right:6px;white-space:nowrap;}
.buy-btn{background:linear-gradient(135deg,var(--ff-orange),var(--ff-orange2));border:none;border-radius:8px;padding:8px 12px;font-size:11px;font-weight:700;color:#fff;cursor:pointer;white-space:nowrap;}
.id-input{background:var(--ff-card2);border:1px solid rgba(0,207,255,0.3);border-radius:10px;padding:10px 14px;color:var(--ff-text);font-size:13px;outline:none;width:100%;}
.id-input::placeholder{color:var(--ff-muted);}
.id-row{display:flex;gap:8px;margin-bottom:12px;}
.id-row .id-input{flex:1;}
.progress-wrap{margin:12px 0;}
.progress-bar-bg{background:var(--ff-card2);border-radius:20px;height:8px;overflow:hidden;margin:6px 0;}
.progress-bar{height:100%;border-radius:20px;background:linear-gradient(90deg,var(--ff-purple),var(--ff-blue));transition:width 0.3s ease;}

.transfer-card{background:linear-gradient(135deg,#1a1a3a,#0d0d2a);border:1px solid rgba(155,89,255,0.35);border-radius:14px;padding:14px 16px;margin-bottom:14px;text-align:center;}
.transfer-card h3{font-size:12px;color:var(--ff-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;}
.transfer-card .transfer-timer{font-size:26px;font-weight:800;color:var(--ff-purple);font-family:monospace;letter-spacing:2px;}
.transfer-card .transfer-sub{font-size:11px;color:var(--ff-muted);margin-top:4px;}

/* NOTIFICATION BELL */
.bell-wrap{position:relative;display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:rgba(255,215,0,0.08);cursor:pointer;}
.bell-wrap .bell-icon{font-size:18px;}
.bell-dot{position:absolute;top:2px;right:2px;width:9px;height:9px;border-radius:50%;background:#ff3d3d;border:2px solid var(--ff-bg);display:none;}
.bell-dot.show{display:block;}

/* VIP */
.vip-card{border-radius:14px;padding:16px;margin-bottom:10px;position:relative;overflow:hidden;}
.vip-card.bronze{background:linear-gradient(135deg,#2a1a0a,#1a1000);border:1px solid #cd7f32;}
.vip-card.silver{background:linear-gradient(135deg,#1a1a2a,#0d0d1a);border:1px solid #c0c0c0;}
.vip-card.gold{background:linear-gradient(135deg,#2a2000,#1a1500);border:1px solid var(--ff-gold);}
.vip-card h3{font-size:15px;font-weight:800;margin-bottom:4px;}
.vip-card p{font-size:11px;color:var(--ff-muted);margin-bottom:10px;}
.vip-perks{font-size:11px;color:var(--ff-text);line-height:1.8;}
.vip-price{font-size:16px;font-weight:800;color:var(--ff-gold);margin-top:10px;}

/* PROFILE */
.profile-hero{background:linear-gradient(135deg,#1a2a4a,#0d1a33);border-radius:16px;padding:20px;text-align:center;margin-bottom:14px;border:1px solid rgba(0,207,255,0.1);}
.avatar{width:76px;height:76px;border-radius:50%;background:linear-gradient(135deg,var(--ff-orange),var(--ff-orange2));display:flex;align-items:center;justify-content:center;font-size:36px;margin:0 auto 10px;border:3px solid rgba(255,255,255,0.15);}
.profile-name{font-size:18px;font-weight:700;}
.profile-id{font-size:11px;color:var(--ff-muted);margin-top:3px;}
.profile-code{font-size:15px;font-weight:800;color:var(--ff-blue);background:rgba(0,207,255,0.1);border:1px solid rgba(0,207,255,0.3);border-radius:10px;padding:5px 14px;display:inline-block;margin-top:7px;letter-spacing:3px;font-family:monospace;}
.profile-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:14px;}
.ps{background:rgba(0,0,0,0.3);border-radius:10px;padding:10px 4px;text-align:center;}
.ps .v{font-size:18px;font-weight:800;color:var(--ff-gold);}
.ps .l{font-size:9px;color:var(--ff-muted);text-transform:uppercase;letter-spacing:0.5px;margin-top:2px;}
.spent-card{background:var(--ff-card);border:1px solid rgba(255,215,0,0.15);border-radius:14px;padding:14px;margin-bottom:12px;}
.spent-card h3{font-size:11px;font-weight:600;color:var(--ff-muted);margin-bottom:10px;text-transform:uppercase;letter-spacing:1px;}
.spent-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.05);font-size:12px;}
.spent-row:last-child{border-bottom:none;}
.spent-row .amount{font-weight:700;color:var(--ff-gold);}
.theme-row{display:flex;gap:8px;margin-bottom:14px;}
.theme-btn{flex:1;padding:10px;border:1px solid rgba(255,255,255,0.1);border-radius:10px;background:var(--ff-card);color:var(--ff-text);font-size:12px;font-weight:600;cursor:pointer;text-align:center;transition:all 0.2s;}
.theme-btn.active{border-color:var(--ff-orange);background:rgba(255,107,0,0.15);}

/* FLASH */
#flash{position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-100px);background:linear-gradient(135deg,#1a3a1a,#0d2a0d);border:1px solid #00ff88;border-radius:14px;padding:11px 22px;color:#00ff88;font-size:13px;font-weight:700;z-index:9999;transition:transform 0.3s ease;pointer-events:none;white-space:nowrap;max-width:320px;text-align:center;}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:500;display:flex;align-items:center;justify-content:center;padding:20px;}
.modal-overlay.hidden{display:none;}
.modal{background:var(--ff-card);border:1px solid rgba(0,207,255,0.2);border-radius:18px;padding:24px;width:100%;max-width:340px;text-align:center;}
.modal h3{font-size:18px;font-weight:700;color:var(--ff-blue);margin-bottom:8px;}
.modal p{font-size:13px;color:var(--ff-muted);margin-bottom:16px;line-height:1.6;}
.modal-btns{display:flex;gap:8px;}
.modal-btn{flex:1;padding:12px;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;}
.modal-btn.primary{background:linear-gradient(135deg,var(--ff-orange),var(--ff-orange2));color:#fff;}
.modal-btn.secondary{background:var(--ff-card2);color:var(--ff-muted);}

/* LIGHT THEME */
body.light{background:#f0f4ff;}
body.light #app{background:#f0f4ff;color:#1a1a2a;}
body.light .page{background:#f0f4ff;}
body.light .topbar{background:linear-gradient(135deg,#1a3a7a,#0d2a5a);}
body.light .nav{background:#e8eeff;border-color:rgba(0,100,200,0.2);}
body.light .nav-btn{color:#888;}
body.light .nav-btn.active{color:var(--ff-orange);}
body.light .ad-box,.light .stat-card,.light .task-item,.light .history-item,.light .lb-item,.light .spent-card,.light .profile-hero,.light .scratch-wrap,.light .diamond-pkg,.light .timer-card,.light .vip-card.bronze,.light .bonus-banner{background:#ffffff;color:#1a1a2a;}
body.light .ad-hero{background:linear-gradient(135deg,#1a3a6e,#0d2040);}
</style>
</head>
<body>
<div id="splash">
  <div class="splash-logo">💎</div>
