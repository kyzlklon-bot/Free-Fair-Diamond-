// АЛМАЗДЫ САТЫП АЛУ (ЖАҢА 5 СЕКУНДТЫҚ АНИМАЦИЯМЕН)
function buyPackage(diamonds,cost){
  var id=document.getElementById('gameId').value.trim();
  if(!id){flash('Enter Game ID first!');return;}
  if(!/^[0-9]{1,11}$/.test(id)){flash('Game ID must be digits only (max 11)!');return;}
  if(state.balance<cost){flash('Need '+cost+' Coin! Watch more ads.');return;}
  
  var overlay = document.getElementById('purchaseOverlay');
  var bar = document.getElementById('purchaseBar');
  var pctText = document.getElementById('purchasePct');
  
  overlay.style.display = 'flex';
  var p = 0;
  
  var interval = setInterval(function(){
    p += 1; // 5 секунд ішінде 100% болуы үшін әр 50мс сайын 1% қосылады
    bar.style.width = p + '%';
    pctText.textContent = p + '%';
    
    if(p >= 100) {
      clearInterval(interval);
      setTimeout(function() {
        overlay.style.display = 'none';
        bar.style.width = '0%';
        pctText.textContent = '0%';
        
        state.balance-=cost;state.diamonds+=diamonds;state.gameId=id;
        state.purchases.unshift({label:'💎 '+diamonds+' diamonds (ID:'+id+')',cost:'-'+cost+' Coin'});
        addHistory('💎 Bought '+diamonds+' diamonds','-'+cost+' Coin');
        state.tasks.buy1=true;checkTaskReward('buy1',100);
        checkAchievements();
        startTransfer();
        updateAll();
        flash(diamonds+' Diamonds added! 💎');
      }, 300); // 100% толғаннан кейін сәл ғана үзіліс (жақсы көрінуі үшін)
    }
  }, 50); // 100 * 50 = 5000ms = 5 секунд
}

function startTransfer(){
  state.transferEndSec=5*3600;
  state.bellReady=false;
  var dot=document.getElementById('bellDot');if(dot)dot.classList.remove('show');
  var tc=document.getElementById('transferCard');if(tc)tc.style.display='block';
}

// VIP САТЫП АЛУ ЖӘНЕ 30 КҮНГЕ САҚТАУ
function buyVIP(level,cost){
  var now = Date.now();
  if(state.vip !== 'FREE' && state.vipExpiry && state.vipExpiry > now) {
    flash('Сізде VIP қазірдің өзінде белсенді (30 күнге)!');
    return;
  }
  if(state.balance<cost){flash('Need '+cost+' Coin!');return;}
  
  state.balance-=cost;
  state.vip=level.toUpperCase();
  state.vipExpiry = now + (30 * 24 * 60 * 60 * 1000); // 30 күн (миллисекундпен)
  
  state.purchases.unshift({label:'👑 '+level.toUpperCase()+' VIP',cost:'-'+cost+' Coin'});
  addHistory('👑 VIP activated',level.toUpperCase());
  updateAll();
  flash('👑 '+level.toUpperCase()+' VIP activated!');
  showModal('VIP АКТИВТЕЛДІ!','Сіз енді ' + level.toUpperCase() + ' VIP мәртебесіне 30 күнге ие болдыңыз!','Керемет!');
}

